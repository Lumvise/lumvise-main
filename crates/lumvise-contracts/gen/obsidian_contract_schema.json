  "obSyncRequestV1": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "appliedRevision": {
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "contentHashes": {
        "additionalProperties": {
          "type": "string"
        },
        "default": {},
        "type": "object"
      },
      "schemaVersion": {
        "format": "uint32",
        "minimum": 0.0,
        "type": "integer"
      },
      "sourceId": {
        "type": "string"
      }
    },
    "required": [
      "schemaVersion",
      "sourceId"
    ],
    "title": "ObsidianSyncRequestV1",
    "type": "object"
  }
