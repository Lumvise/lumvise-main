          "contentMd5",
          "markdown",
          "ownerElementId",
          "ownerKind",
          "ownerTitle",
          "title"
        ],
        "type": "object"
      },
      "KnowledgeElementChildV1": {
        "additionalProperties": false,
        "properties": {
          "elementId": {
            "type": "string"
