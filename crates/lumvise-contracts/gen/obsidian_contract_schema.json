          "changeMarker",
          "children",
          "contentMd5",
          "elementId",
          "kind",
          "linkTargets",
          "markdown",
          "ownership",
          "pathHint",
          "properties",
          "sourceId",
          "sourceRefs",
          "space",
          "syncToken",
          "title",
          "writePolicy"
